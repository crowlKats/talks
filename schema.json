{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conference Presentation",
  "description": "Schema for a list of conference presentations.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "date",
      "conference",
      "title",
      "duration",
      "slides"
    ],
    "properties": {
      "date": {
        "type": "string",
        "format": "date",
        "description": "The date of the presentation in YYYY-MM-DD format."
      },
      "conference": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the conference."
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the conference's website."
          }
        }
      },
      "location": {
        "type": "string",
        "description": "Where the presentation took place, as \"City, Country\". Omitted for remote-only appearances."
      },
      "copresenters": {
        "type": "array",
        "description": "Other people who presented alongside, besides Leo Kettmeir.",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "The co-presenter's name."
            },
            "website": {
              "type": "string",
              "format": "uri",
              "description": "URL of the co-presenter's website, if they have one."
            }
          },
          "additionalProperties": false
        }
      },
      "title": {
        "type": "string",
        "description": "The title of the presentation."
      },
      "recording": {
        "type": "string",
        "format": "uri",
        "description": "URL to recording, if it exists."
      },
      "slides": {
        "description": "The slides for the presentation. Can be 'slidev' for Slidev-based slides, a Google Slides URL, or null if no slides are available.",
        "oneOf": [
          {
            "type": "string",
            "const": "slidev"
          },
          {
            "type": "string",
            "format": "uri",
            "pattern": "^https://docs\\.google\\.com/presentation/d/.*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "kind": {
        "type": "string",
        "enum": ["talk", "session"]
      },
      "duration": {
        "type": "number",
        "description": "The duration of the talk"
      }
    },
    "additionalProperties": false
  }
}
